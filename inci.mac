;   You should have received a copy of the GNU General Public License along
;   with this program.	If not, see <http://www.gnu.org/licenses/>.
;
;   06 Jun 87	1.0   - Initial version - MT
;   18 Aug 91	2.0   - Modified  to use call by value rather than call  by
;			reference - MT
;
;   inci (integer);
;
;   Increments a 16-bit integer in HL, and returns the status in A.
;
;
INCI::		FUNCTION		; Return value in HL.
		XOR	A		; Clear carry, needed for subtract.
		LD	DE,1
		ADC	HL,DE		; Add 1.
		RET	PO		; No overflow, return zero.
		CPL			; Set status bits.
		RET
;
		END
