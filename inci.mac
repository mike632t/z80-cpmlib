		TITLE	inci (integer):integer - 06 Jun 87 - MT
		SUBTTL	'Integer increment'
;
		INCLUDE	SYMBOLS
		DEFB	'%%INCI 2.0 - 18 Aug 91%%'
;
;-- Function to increment a 16-bit number.
;
