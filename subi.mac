;   General Public License for more details.
;
;   You should have received a copy of the GNU General Public License along
;   with this program.  If not, see <http://www.gnu.org/licenses/>.
;
;   12 Sep 87	1.0   - Initial version - MT
;   10 Sep 26	2.0   - Modified  to use call by value rather than call  by
;                       reference - MT
;
;   subi (integer, integer):integer
;
;   Subtract two 16 bit integer values in HL and DE returning the result in 
;   HL.
;
;   Returns success/fail in A.
;
SUBI::		FUNCTION		; Return value in HL.
		XOR	A		; Clear carry.
		SBC	HL,DE 		; Subtract DE from HL.
		RET	PO              ; No overflow, status is zero.
		CPL			; Set status bits.
		RET
;
		END
